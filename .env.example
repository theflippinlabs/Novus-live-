# NOVUS LIVE — server-side configuration.
# Every variable here is read ONLY by the Node server. None is ever sent to the browser.
# Copy to .env (or set in your host's dashboard). Everything is optional: with no
# variables at all Novus runs in demo mode with deterministic local moderation.

# ---- Server -----------------------------------------------------------------
PORT=8787
# HOST=0.0.0.0
# Set to true when running behind a reverse proxy / PaaS load balancer (Railway, Render, Fly…)
# so rate limiting sees the real client IP.
TRUST_PROXY=false

# ---- Access control -----------------------------------------------------------
# Strongly recommended for any public deployment. When set, the app asks for this key
# once and stores an HttpOnly, SameSite=Strict session cookie (min 12 chars).
APP_ACCESS_TOKEN=

# ---- AI (stage 2 contextual moderation) ---------------------------------------
# Without a key, Novus runs entirely on stage-1 local heuristics.
ANTHROPIC_API_KEY=
# Default: claude-opus-5. For lower cost per review you can use e.g. claude-sonnet-5 or claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high (ignored for Haiku). Low keeps moderation reviews fast and cheap.
ANTHROPIC_EFFORT=low
# Hard budget: max AI review calls per minute (each call reviews a batch of up to AI_BATCH_SIZE messages).
AI_MAX_CALLS_PER_MINUTE=20
AI_BATCH_SIZE=8

# ---- Persistence (optional) -----------------------------------------------------
# Supabase/Postgres. Apply supabase/migrations first. The service-role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Without Supabase: optional folder where settings, viewer flags and post-LIVE reports are kept as JSON.
DATA_DIR=./data

# ---- Authorized connector ingestion (TikTok or other) ---------------------------
# Enables POST /api/ingest/events and /api/ingest/heartbeat (Bearer token, min 24 chars).
# Leave empty to disable ingestion entirely. See docs/TIKTOK_INTEGRATION.md.
INGEST_TOKEN=

# ---- Rate limits (requests per minute per IP) -------------------------------------
API_RATE_LIMIT_PER_MINUTE=600
INGEST_RATE_LIMIT_PER_MINUTE=1200
